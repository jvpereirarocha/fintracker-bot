# Token do bot, gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token
# Seu user id do Telegram (descubra com o @userinfobot). Mensagens de outros usuários são ignoradas
TELEGRAM_ALLOWED_USER_ID=123456789

# URL base da API do fintracker, incluindo o prefixo /api/v1
FINTRACKER_API_URL=http://localhost:8008/api/v1
FINTRACKER_USERNAME=your_fintracker_username
FINTRACKER_PASSWORD=your_fintracker_password

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-5-5

TIMEZONE=America/Sao_Paulo
